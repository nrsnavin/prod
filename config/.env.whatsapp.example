# ─────────────────────────────────────────────────────────────────
# WhatsApp owner notifications — Twilio (default provider)
#
# Copy the values you need into config/.env. Until all three TWILIO_*
# vars are set, the notification pipeline runs in DRY-RUN mode: it
# logs the exact message it would send instead of sending. Safe to
# deploy and review before spending anything.
#
# Quick start (owner-only, ~10 min):
#   1. Create a Twilio account → Console shows Account SID + Auth Token
#   2. Messaging → Try it out → Send a WhatsApp message → activate the
#      sandbox and send the join code from your phone
#   3. Fill in the three vars below + add your number via the admin
#      settings route (PUT /api/v2/notify/settings { recipients: [...] })
# ─────────────────────────────────────────────────────────────────

# Which adapter to use. "twilio" is the only one implemented today.
WHATSAPP_PROVIDER=twilio

TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here

# The Twilio WhatsApp sender. Sandbox default is the number below;
# a production sender is your own approved WhatsApp number.
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
