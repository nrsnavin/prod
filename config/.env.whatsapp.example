# ─────────────────────────────────────────────────────────────────
# WhatsApp owner notifications — Twilio (default provider)
#
# Copy the values you need into config/.env. Until all three TWILIO_*
# vars are set, the notification pipeline runs in DRY-RUN mode: it
# logs the exact message it would send instead of sending. Safe to
# deploy and review before spending anything.
#
# Quick start (owner-only, ~10 min):
#   1. Create a Twilio account → Console shows Account SID + Auth Token
#   2. Messaging → Try it out → Send a WhatsApp message → activate the
#      sandbox and send the join code from your phone
#   3. Fill in the three vars below + add your number via the admin
#      settings route (PUT /api/v2/notify/settings { recipients: [...] })
# ─────────────────────────────────────────────────────────────────

# Which adapter to use. "twilio" is the only one implemented today.
WHATSAPP_PROVIDER=twilio

TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here

# The Twilio WhatsApp sender. Sandbox default is the number below;
# a production sender is your own approved WhatsApp number.
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ─────────────────────────────────────────────────────────────────
# Morning digest scheduling (9 AM consolidated message)
#
# The digest is fired by hitting an endpoint — no in-process cron, so
# it survives restarts and scales. Protect the public trigger with a
# shared secret, then point any scheduler at it.
#
# Set a long random secret:
CRON_SECRET=change-me-to-a-long-random-string
#
# Then add a system crontab entry (server local time) — 9 AM daily:
#   0 9 * * *  curl -fsS -X POST \
#     -H "x-cron-secret: <CRON_SECRET>" \
#     http://localhost:2701/api/v2/notify/cron/run-digest >/dev/null
#
# Or trigger manually as admin (uses your session, no secret needed):
#   POST /api/v2/notify/run-digest
#   POST /api/v2/notify/run-digest?dryReturn=1   ← returns the text, doesn't send
# ─────────────────────────────────────────────────────────────────
