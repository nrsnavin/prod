# Copy to config/.env and fill with real values (never commit the filled file).
# Rotate any value that was ever committed before using it again.
MONGO_URL=mongodb+srv://<user>:<password>@<cluster>/<db>
PORT=2701
# At least 32 random characters. The server checks this when it starts
# (utils/configRisks.js): unset, it does not start in production; a short
# or published value is logged, listed on /health/build and sent to the
# owner each morning until it is changed.
JWT_SECRET_KEY=<generate: openssl rand -base64 48>

# SameSite for the session cookie. Leave unset ("none") only if the web
# app is on a DIFFERENT site from the API. When they share one —
# erp.example.com and api.example.com do — set this to lax: no other
# site's page can then send the cookie at all.
# SESSION_SAMESITE=lax

# ── Where the apps live ───────────────────────────────────────────
# The web app's address(es), comma-separated, with https:// — the
# browser refuses every API answer to a site not listed here, so the web
# app does not work without it. List the customer portal too. (The phone
# apps are not browsers and do not need it.)
CORS_ORIGINS=https://erp.example.com,https://portal.example.com
#
# The API's own public HTTPS address. WhatsApp report links are built on
# it, and Twilio's webhook signature is checked against it, so it must
# match the webhook URL in the Twilio console. Unset: https://api.baluelastics.com
# PUBLIC_BASE_URL=https://api.example.com
#
# How the server reaches itself (approving an order from WhatsApp).
# Unset: http://localhost:$PORT. Change it only if Node listens elsewhere.
# INTERNAL_BASE_URL=
#
# HOST and NODE_ENV come from deploy/jarvis.service (HOST=127.0.0.1,
# NODE_ENV=PRODUCTION), so Node listens only behind the HTTPS proxy.

# ── Sandbox database (optional) ──────────────────────────────────
# Named users work in a SECOND database on the same cluster; everyone
# else works in the one MONGO_URL points at. Leave SANDBOX_DB empty (or
# unset) and routing is inert — every request uses MONGO_URL's database,
# which is what a normal deployment wants.
#
# The two databases share one connection pool (mongoose useDb), so this
# costs no extra sockets. Logins are NOT routed: `users` always resolves
# to the primary, so there is one set of credentials.
#
# SANDBOX_USERS is a comma-separated list of email addresses.
SANDBOX_DB=
SANDBOX_USERS=

# ── Email (required for sign-in) ─────────────────────────────────
# Email OTP is the PRIMARY sign-in for the web and mobile apps, so a
# deployment without these cannot let anyone log in — /user/request-otp
# answers 503 until they are set. See utils/mailer.js.
#
# Check a running server with:
#   GET /api/v2/health/mailer            (admin session)
#   GET /api/v2/health/mailer?test=you@example.com
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=no-reply@example.com
SMTP_PASS=<the mailbox password>
SMTP_FROM=Balu Elastics ERP <no-reply@example.com>

# Public web origin — used to build password-reset links.
WEB_URL=https://erp.example.com

# ── Processes and threads ─────────────────────────────────────────
# How many API processes to run behind the one port (server/cluster.js).
# Unset: one per core, at most 4, when NODE_ENV=PRODUCTION; one otherwise.
# WEB_CONCURRENCY=1 is the single-process server exactly — the rollback.
# WEB_CONCURRENCY=
#
# Worker threads per process for CPU work — PDF rendering, legacy
# password checks (utils/workerPool.js). Default: min(2, cores - 1).
# WORKER_POOL_SIZE=
#
# PDF_IN_THREAD=1 renders PDFs on the request thread, as before, without
# a deploy — for ruling the worker pool out while diagnosing something.
# PDF_IN_THREAD=

# ── AI (Claude) ───────────────────────────────────────────────────
# Every Claude call goes through utils/aiGateway.js: a timeout, a cap on
# calls running at once, and a circuit breaker that fails fast for a
# minute after repeated outages. The defaults suit one plant; change them
# only to diagnose something. GET /api/v2/health/ai shows the state.
# ANTHROPIC_API_KEY=
# AI_TEXT_TIMEOUT_MS=30000      # per attempt; one retry
# AI_VISION_TIMEOUT_MS=90000    # requests carrying an image or PDF
# AI_TEXT_CONCURRENCY=4         # per process
# AI_VISION_CONCURRENCY=2       # per process
# AI_MAX_QUEUE=20               # waiting calls before "AI is busy"
# AI_BREAKER_FAILURES=5         # outages in a row that open the circuit
# AI_BREAKER_OPEN_MS=60000      # how long it stays open

# Timer photos taken during production entry are kept with the shift for
# whoever verifies it, then dropped by MongoDB after this many days.
# 0 keeps them forever.
# TIMER_PHOTO_RETENTION_DAYS=365

# ── Database reads ────────────────────────────────────────────────
# Server-side time limit on every read (models/plugins/queryTimeLimit.js).
# A read past it is stopped by MongoDB and the request answers 503.
# 0 turns it off. Migrations and scripts never have it.
# DB_QUERY_MAX_MS=30000

# ── Aadhaar numbers ───────────────────────────────────────────────
# 32 random bytes, base64: openssl rand -base64 32
# Set it and Aadhaar numbers are encrypted when saved (utils/aadhaar.js);
# then run `node scripts/encrypt-aadhaar.js --apply` once to seal the
# ones already stored. Losing this key loses the sealed numbers: back it
# up with the other secrets. Unset: numbers are stored unencrypted (but
# are still masked in every screen and response).
# AADHAAR_KEY=

# ── The bank's statements, by email (services/bankFeed.js) ──────────
# Set the bank's corporate net banking to email a scheduled statement
# (CSV or Excel, daily or more often) to a mailbox only for this, and
# the ERP reads it every BANK_FEED_EVERY_MIN minutes: lines land in
# Accounts → Inbox, matched where they can be. Unset: off.
# BANK_FEED_IMAP_HOST=imap.hostinger.com
# BANK_FEED_IMAP_PORT=993
# BANK_FEED_IMAP_USER=statements@example.com
# BANK_FEED_IMAP_PASS=<that mailbox's password>
# BANK_FEED_MAILBOX=INBOX
# Who may send statements: addresses or @domains, comma-separated.
# BANK_FEED_SENDERS=@kotak.com,alerts@icicibank.com
# BANK_FEED_EVERY_MIN=15
# ── The same statements by SFTP (MT940 or CSV), from the bank's cash-management desk ──
# BANK_SFTP_HOST=
# BANK_SFTP_PORT=22
# BANK_SFTP_USER=
# BANK_SFTP_PASS=                 # or BANK_SFTP_KEY=/path/to/private_key (+ BANK_SFTP_KEY_PASSPHRASE)
# BANK_SFTP_HOST_KEY=SHA256:...   # required; the first run reports the key the server offers
# BANK_SFTP_DIR=/                 # the folder the bank drops statements in
# BANK_SFTP_DONE_DIR=             # optional: move files here once read

# ── Customer portal ───────────────────────────────────────────────
# Its own secret for customer sessions (32+ random characters). Unset:
# JWT_SECRET_KEY is used for both.
# PORTAL_JWT_SECRET_KEY=
# PORTAL_JWT_EXPIRES=7d

# ── The plant's clock ─────────────────────────────────────────────
# Business days, shift dates and auto-verify follow this zone, whatever
# the server's own clock says.
# FACTORY_TZ=Asia/Kolkata
# Dispatch slots: minutes east of UTC.
# DISPATCH_TZ_OFFSET_MIN=330

# ── What the server sends on its own ──────────────────────────────
# Times are India time, "HH:MM". Each goes once a day however many API
# processes run, so no crontab is needed. WhatsApp sending needs the
# TWILIO_* values in config/.env.whatsapp.example; CRON_SECRET there is
# only for an outside scheduler, which the built-in timer replaces.
# SCHEDULED_REPORTS=off          # turns off the three reports below
# DIGEST_AT=09:00                # morning digest
# EVENING_REPORT_AT=21:00        # evening report
# AUDIT_WATCH_AT=09:30           # Mondays: the week's risky changes
# Each of these turns one sender off:
# COLLECTION_REMINDERS=off       # payment reminders to customers
# COLLECTION_REMINDERS_MAX=30    # at most this many reminders a day
# NOTICE_REMINDERS=off           # GST and government notice deadlines
# PO_CHASE=off                   # chasing suppliers on late purchase orders
# SHIFT_END_NUDGE=off            # looms not entered before the shift ends
# SHIFT_HANDOVER=off             # the shift handover message

# ── AI models and waits ───────────────────────────────────────────
# Unset: the models named in utils/anthropicClient.js.
# ANTHROPIC_MODEL=               # text
# SHIFT_OCR_MODEL=               # photos, sheets and PDFs
# How long a reply waits for the AI before going without it (ms):
# COLLECTION_REPLY_AI_MS=6000
# CUSTOMER_ASSISTANT_AI_MS=6000
# FLOOR_REMARK_AI_MS=5000
# INBOX_TRIAGE_AI_MS=8000
# PO_CHASE_AI_MS=6000

# ── How long photos and readings are kept (days; 0 keeps them) ────
# SLIP_PHOTO_RETENTION_DAYS=365
# LOOM_READING_RETENTION_DAYS=120

# ── Errors and the build ──────────────────────────────────────────
# Send server errors to Sentry. Unset: they are only logged.
# SENTRY_DSN=
# Shown on /api/v2/health/build (GIT_COMMIT_SHA is read first, then
# this). Unset: read from the git checkout.
# COMMIT_SHA=

# ── Not for this file ─────────────────────────────────────────────
# The one-off scripts in scripts/ read MONGO_URI or DB_URL (point them at
# MONGO_URL's value when you run one), and seedDemoCustomer.js reads
# MONGODB_URI and DEMO_*. The Tally connector (tools/tally-connector)
# runs on the PC with Tally and has its own TALLY_URL, JARVIS_URL,
# JARVIS_KEY, INTERVAL_SEC and LEDGERS_EVERY_MIN.
