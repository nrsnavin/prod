# ── systemd unit for the Jarvis Node backend ──────────────────────
#
# Runs the API as a managed service that restarts on crash and on boot,
# bound to localhost so only the TLS proxy can reach it. This also fixes
# the "the deploy didn't take because nobody restarted node" class of
# incident — `systemctl restart jarvis` is the one command after a pull.
#
# Install:
#   sudo cp deploy/jarvis.service /etc/systemd/system/jarvis.service
#   # edit User / WorkingDirectory / EnvironmentFile below to match the box
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now jarvis
#   systemctl status jarvis
#   journalctl -u jarvis -f          # tail logs (request + error JSON lines)

[Unit]
Description=Jarvis ERP API
After=network.target

# systemd's defaults are StartLimitBurst=5 within StartLimitIntervalSec=10s.
# With RestartSec=3 that budget is spent in well under a minute, so a
# database outage longer than that used to leave the unit in `failed` state
# permanently — needing a manual `systemctl reset-failed` even after the
# database came back. Widening the window lets it keep retrying through a
# replica-set election or a short network partition and recover on its own.
StartLimitIntervalSec=300
StartLimitBurst=30

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/prod
# Secrets live here, OUTSIDE git (untracked). Provision this file on the
# box; never commit it. Must define PORT, MONGO_URL, JWT_SECRET_KEY, etc.
EnvironmentFile=/home/ubuntu/prod/config/.env
# Bind to localhost — the TLS proxy is the only public entry point.
Environment=NODE_ENV=PRODUCTION
Environment=HOST=127.0.0.1
ExecStart=/usr/bin/node index.js
# `always`, not `on-failure`: a clean exit(0) from an unexpected path is
# still the service not running, which is the thing we care about.
Restart=always
RestartSec=3
# Give in-flight requests time to drain on SIGTERM (index.js closes the
# listener and waits) before systemd escalates to SIGKILL.
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
