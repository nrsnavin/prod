# ── Jarvis ERP — Caddy reverse proxy with automatic HTTPS ──────────
#
# Recommended TLS front end. Caddy obtains and auto-renews a Let's
# Encrypt certificate on its own — no certbot, no cron, no renewal
# script. It listens on 443 (and redirects 80→443) and forwards to the
# Node app on localhost:2701.
#
# Prerequisites:
#   1. A DNS A record: api.baluelastics.com → 3.6.171.27
#   2. AWS security group / firewall: inbound 80 and 443 open;
#      2701 NOT open to the public (proxy reaches it on localhost).
#   3. Node bound to localhost: set HOST=127.0.0.1 in the app's env.
#
# Replace api.baluelastics.com with your real hostname, then:
#   sudo caddy run --config deploy/Caddyfile        # foreground test
#   sudo caddy start --config deploy/Caddyfile      # background
# or install as a service (see deploy/TLS_SETUP.md).

api.baluelastics.com {
	encode gzip

	# The largest file the app itself accepts is 25 MB (a scanned shift
	# sheet); bills and statements are 10–20 MB and a phone photo is
	# often over 6. This was 6MB, which refused uploads the app would
	# have taken. The Node app enforces its own 1 MB JSON cap and a cap
	# per upload route. tests/deploy/proxyLimits.test.js holds this
	# above the app's largest.
	request_body {
		max_size 26MB
	}

	reverse_proxy 127.0.0.1:2701 {
		# Preserve the real client info so the app's `trust proxy` sees
		# the true protocol/IP (rate-limit keying, secure-cookie check).
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-For {remote_host}
		header_up Host {host}
	}
}

# ── React web app (prod_web) ───────────────────────────────────────
# Serves the built SPA (dist/) as static files with its own auto-TLS
# cert. The app itself calls the API cross-origin at
# https://api.baluelastics.com — so the backend's CORS_ORIGINS env MUST
# include https://erp.baluelastics.com (the auth cookie is
# SameSite=None; Secure, which allows the cross-subdomain request).
#
# Deploy: build prod_web (`npm run build`) and put the contents of dist/
# into /var/www/erp on this box. See deploy/WEB_DEPLOY.md.
erp.baluelastics.com {
	encode gzip
	root * /var/www/erp

	# Long-cache the fingerprinted assets; never cache index.html so a
	# new deploy is picked up immediately.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	header /index.html Cache-Control "no-cache"

	# SPA fallback — client-side routes (/orders, /reports/...) resolve
	# to index.html instead of 404ing.
	try_files {path} /index.html
	file_server
}

# ── Customer portal (prod_web: npm run build:portal) ───────────────
# A separate small app where customers see their own orders,
# dispatches, certificates, invoices and statement. It calls
# https://api.baluelastics.com/api/v3/portal, so CORS_ORIGINS must
# include https://portal.baluelastics.com as well.
#
# Deploy: put the contents of prod_web's dist-portal/ into /var/www/portal.
portal.baluelastics.com {
	encode gzip
	root * /var/www/portal

	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	header /index.html Cache-Control "no-cache"
	# Customers' pages are nobody's search result.
	header X-Robots-Tag "noindex"

	try_files {path} /index.html
	file_server
}
